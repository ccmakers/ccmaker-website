---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Message Sent"
  description="Thank you for contacting Cape Cod Makers."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 text-center">
    <div class="max-w-md mx-auto">
      <div class="text-5xl mb-6">✅</div>
      <h1 class="text-4xl font-bold mb-4">Message Sent!</h1>
      <p class="text-gray-600 mb-8">
        Thanks for reaching out. We'll get back to you as soon as possible.
      </p>
      <a
        href="/"
        class="inline-block bg-ccm-blue text-white px-8 py-3 rounded-lg font-semibold hover:bg-blue-700 transition-colors"
      >
        Back to Home
      </a>
    </div>
  </div>
</BaseLayout>
